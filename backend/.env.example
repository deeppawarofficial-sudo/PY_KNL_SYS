# Environment variables for Python FastAPI Backend Engine
# Hugging Face Access Token for Nemotron LLM & BAAI/bge-large-en-v1.5 embeddings
HF_TOKEN=your_hf_token_here
HUGGINGFACEHUB_API_TOKEN=your_hf_token_here

# LLM Engine & Embedding Model IDs
NEMOTRON_MODEL=nvidia/Llama-3.1-Nemotron-70B-Instruct-HF
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# Server configuration
PORT=8000
HOST=0.0.0.0

# Optional External Qdrant Vector DB
QDRANT_URL=
QDRANT_API_KEY=
