# Environment variables for Python FastAPI Backend Engine
# Hugging Face Access Token for Nemotron LLM & BAAI/bge-large-en-v1.5 embeddings
HF_TOKEN=your_hf_token_here
HUGGINGFACEHUB_API_TOKEN=your_hf_token_here

# LLM Engine & Embedding Model IDs
NEMOTRON_MODEL=nvidia/Llama-3.1-Nemotron-70B-Instruct-HF
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# Server configuration
PORT=8000
HOST=0.0.0.0

# Qdrant Cloud Vector DB (leave empty to use In-Memory fallback)
# Get your cluster URL & API key from: https://cloud.qdrant.io
QDRANT_URL=https://<your-cluster-id>.<region>.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=paper_chunks

# Groq Cloud API (openai/gpt-oss-120b primary, fallback to openai/gpt-oss-20b)
GROQ_API_KEY=your_groq_api_key_here
GROK_MODEL=openai/gpt-oss-120b

