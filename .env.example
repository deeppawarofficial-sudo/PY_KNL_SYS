# Environment Variables Configuration Template
# Copy this file to .env and set your secrets

# Hugging Face Access Token: Required for Nvidia Nemotron LLM inference & BAAI/bge-large-en-v1.5 embeddings
# Get your access token from Hugging Face: https://huggingface.co/settings/tokens
HF_TOKEN=your_hf_token_here
HUGGINGFACEHUB_API_TOKEN=your_hf_token_here

# Nvidia Nemotron LLM Model ID
NEMOTRON_MODEL=nvidia/Llama-3.1-Nemotron-70B-Instruct-HF

# Hugging Face Dense Embedding Model ID
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# Base URL for API calls (Leave blank for relative origin http://localhost:3000)
VITE_API_BASE_URL=

# Web Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Optional External Qdrant Vector DB (Leave empty for In-Memory Qdrant Collection)
QDRANT_URL=
QDRANT_API_KEY=

# Local LLM Engine Configuration (Ollama / LM Studio / LocalAI)
OLLAMA_MODEL=qwen2.5:3b
LOCAL_LLM_URL=http://localhost:11434/v1/chat/completions
